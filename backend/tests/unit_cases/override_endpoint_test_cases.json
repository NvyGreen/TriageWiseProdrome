          "flag_tier": 3
        },
        "intake_record": {
          "intake_id": 7007,
          "patient_id": 305
        }
      },
      "request": {
        "headers": {
          "Idempotency-Key": "key-badesi-007"
        },
        "body": {
          "severity_id": 8007,
          "clinician_esi": "ESI-9",
          "reason_code": "AI driver incorrect",
