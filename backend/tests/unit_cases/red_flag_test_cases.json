    {
      "_name": "flag8_positive_febrile_neonate",
      "_why": "age 30 days + temp 100.6F → Tier 1 febrile infant.",
      "_dob_note": "dob is recomputed by the test as today minus _dob_days_ago; a literal date would age out of flag 8's neonate window and stop firing.",
      "intake": {
        "_dob_days_ago": 30,
        "chief_complaint": "general",
        "heart_rate": 140,
        "blood_pressure_systolic": 80,
        "respiration_rate": 40,
        "temperature": 100.6,
        "oxygen_saturation": 98,
        "pain_level": 0,
        "symptoms": []
      },
      "score_in": {
        "severity_score": 1,
        "esi_level": 4,
        "all_vitals_normal": true
      },
      "expect": {
        "fired": [
          8,
          9
        ],
        "flag_tier": 1,
        "score_unchanged": true
      },
      "_finding": "DESIGN GAP: normal neonatal vitals (HR ~140, SBP ~80) trip flag 9's ADULT shock thresholds (HR>=100, SBP<=100). Flag 8 and flag 9 collide for infants. Either age-gate flag 9 (adults only) or use age-specific shock thresholds. Until then, a febrile neonate fires BOTH — tier is 1 either way so triage is unharmed, but the flag_9 banner is clinically wrong for a baby."
    },
