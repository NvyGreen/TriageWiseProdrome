{
  "_meta": {
    "title": "TriageWiseProdrome — getPatientDetail composition cases (reqs getPatientDetail / detail endpoint; D1 surface)",
    "validates": "TriageService.getPatientDetail(intake_id) assembles a PatientDetail from STORED rows, and GET /intakes/{id} returns it. Composition + rehydration + endpoint contract — NOT the lede text (see lede_test_cases.json) or the Explanation content (see explanation_test_cases.json).",
    "nature": "INTEGRATION, not pure-function. Each case seeds DB rows (patient, intake_record, patient_severity, ai_explanation, optionally override), calls getPatientDetail / the endpoint, and asserts the assembled bundle. There is no scoring here — the rows are pre-seeded to isolate composition.",
    "scope_notes": [
      "Mode toggle (xai/blackbox) is R1 — NOT tested here. These cases assume full (xai) assembly: all fields populated.",
      "The lede STRING is asserted in lede_test_cases.json; here we only assert that PatientDetail.lede is present/non-empty.",
      "Explanation field VALUES are asserted in explanation_test_cases.json; here we only assert the Explanation is attached and rehydrated (drivers are Driver objects, gaps has 5 keys).",
      "explanation_viewed event: getPatientDetail fires it in xai mode. Asserted here as a side effect."
    ],
    "patient_detail_shape": {
      "patient": "Patient (name, dob->age, sex)",
      "intake": "IntakeRecord",
      "missingFields": "list[str]",
      "severity": "PatientSeverity row (severity_score, system_ESI, clinician_ESI, confidence, red_flags, flag_tier)",
      "explanation": "Explanation (rehydrated: named_drivers as Driver objects, gap_acknowledgement dict with 5 keys, data_completeness, fallback_instruction)",
      "lede": "str (composed via _render_lede; non-empty)",
      "redFlags": "list[Trigger] rehydrated from patient_severity.red_flags JSONB",
      "override": "Override or null"
    }
  },

  "cases": [
    {
      "_name": "full_bundle_no_flags_no_override",
      "_why": "Baseline: a scored patient with no red flags and no override. Every field composes; redFlags empty, override null.",
      "seed": {
        "patient": {"patient_id": 100, "name": "Test Patient A", "date_of_birth": "1970-04-10", "sex": "F"},
        "intake_record": {"intake_id": 5001, "patient_id": 100, "chief_complaint": "cardiac", "missing_fields": []},
        "patient_severity": {"intake_id": 5001, "severity_score": 9, "system_ESI": "ESI-1", "clinician_ESI": null, "confidence": "HIGH", "red_flags": [], "red_flag_fired": false, "flag_tier": 3},
        "ai_explanation": {"intake_id": 5001, "data_completeness": "5 of 5", "factor_breakdown": [
          {"rule_id": 9, "factor": "Chief complaint", "threshold": "chest pain (cardiac concern)", "weight": 6, "patient_value": "cardiac", "contribution_pct": 67},
          {"rule_id": 3, "factor": "Heart rate", "threshold": "> 120 bpm", "weight": 3, "patient_value": 124, "contribution_pct": 33}
        ], "gaps": {"not_provided": [], "assumed": [], "recorded_not_scored": [], "red_flag_input": [], "beyond_the_data": ["Appearance, work of breathing, distress, social context, staffing - outside this engine."]}}
      },
      "call": {"intake_id": 5001},
      "expect": {
        "status_code": 200,
        "patient_name": "Test Patient A",
        "severity_score": 9,
        "system_ESI": "ESI-1",
        "band_name": "Critical",
        "confidence": "HIGH",
        "driver_count": 2,
        "drivers_are_Driver_objects": true,
        "gap_keys_present": ["not_provided", "assumed", "recorded_not_scored", "red_flag_input", "beyond_the_data"],
        "lede_present": true,
        "red_flags": [],
        "override": null,
        "event_logged": "explanation_viewed"
      }
    },
    {
      "_name": "bundle_with_red_flags_rehydrated",
      "_why": "red_flags JSONB must rehydrate into Trigger objects for the banners; flag_tier carried; red_flag_fired true.",
      "seed": {
        "patient": {"patient_id": 101, "name": "Test Patient B", "date_of_birth": "1960-01-01", "sex": "M"},
        "intake_record": {"intake_id": 5002, "patient_id": 101, "chief_complaint": "stroke", "missing_fields": []},
        "patient_severity": {"intake_id": 5002, "severity_score": 6, "system_ESI": "ESI-2", "clinician_ESI": null, "confidence": "HIGH",
          "red_flags": [{"flag_id": 5, "message": "Possible stroke - FAST positive", "flag_tier": 1}], "red_flag_fired": true, "flag_tier": 1},
        "ai_explanation": {"intake_id": 5002, "data_completeness": "5 of 5", "factor_breakdown": [
          {"rule_id": 8, "factor": "Chief complaint", "threshold": "stroke symptoms (FAST)", "weight": 6, "patient_value": "stroke", "contribution_pct": 100}
        ], "gaps": {"not_provided": [], "assumed": [], "recorded_not_scored": [], "red_flag_input": [], "beyond_the_data": ["Appearance, work of breathing, distress, social context, staffing - outside this engine."]}}
      },
      "call": {"intake_id": 5002},
      "expect": {
        "status_code": 200,
        "system_ESI": "ESI-2",
        "band_name": "Emergent",
        "red_flags_count": 1,
        "red_flags_are_Trigger_objects": true,
        "red_flag_flag_tier": 1,
        "lede_present": true,
        "override": null,
        "event_logged": "explanation_viewed",
        "_note": "red_flags JSONB stores flag_id/message/flag_tier. If Trigger also needs flag_type/rationale, the rehydration must join red_flag_rule by flag_id - assert those are populated too, or accept they're null."
      }
    },
    {
      "_name": "bundle_with_override_dual_score",
      "_why": "A clinician override present: system_ESI and clinician_ESI differ; override object attached (R2 dual-score surface).",
      "seed": {
        "patient": {"patient_id": 102, "name": "Test Patient C", "date_of_birth": "1955-06-15", "sex": "M"},
        "intake_record": {"intake_id": 5003, "patient_id": 102, "chief_complaint": "cardiac", "missing_fields": []},
        "patient_severity": {"intake_id": 5003, "severity_score": 6, "system_ESI": "ESI-2", "clinician_ESI": "ESI-1", "confidence": "HIGH", "red_flags": [], "red_flag_fired": false, "flag_tier": 3},
        "ai_explanation": {"intake_id": 5003, "data_completeness": "5 of 5", "factor_breakdown": [
          {"rule_id": 9, "factor": "Chief complaint", "threshold": "chest pain (cardiac concern)", "weight": 6, "patient_value": "cardiac", "contribution_pct": 100}
        ], "gaps": {"not_provided": [], "assumed": [], "recorded_not_scored": [], "red_flag_input": [], "beyond_the_data": ["Appearance, work of breathing, distress, social context, staffing - outside this engine."]}},
        "override": {"intake_id": 5003, "system_esi": "ESI-2", "clinician_esi": "ESI-1", "reason_code": "clinical_judgment"}
      },
      "call": {"intake_id": 5003},
      "expect": {
        "status_code": 200,
        "system_ESI": "ESI-2",
        "clinician_ESI": "ESI-1",
        "override_present": true,
        "override_reason_code": "clinical_judgment",
        "lede_present": true,
        "event_logged": "explanation_viewed"
      }
    },
    {
      "_name": "bundle_with_gaps_and_missing_fields",
      "_why": "Incomplete-data patient: missing_fields populated, gaps has not_provided/assumed, drivers fewer. All compose into the bundle.",
      "seed": {
        "patient": {"patient_id": 103, "name": "Test Patient D", "date_of_birth": "1994-03-20", "sex": "F"},
        "intake_record": {"intake_id": 5004, "patient_id": 103, "chief_complaint": "respiratory", "missing_fields": ["oxygen_saturation", "respiration_rate", "blood_pressure_systolic"]},
        "patient_severity": {"intake_id": 5004, "severity_score": 5, "system_ESI": "ESI-3", "clinician_ESI": null, "confidence": "LOW", "red_flags": [], "red_flag_fired": false, "flag_tier": 3},
        "ai_explanation": {"intake_id": 5004, "data_completeness": "2 of 5", "factor_breakdown": [
          {"rule_id": 10, "factor": "Chief complaint", "threshold": "shortness of breath", "weight": 4, "patient_value": "respiratory", "contribution_pct": 80},
          {"rule_id": 4, "factor": "Heart rate", "threshold": "100-120 bpm", "weight": 1, "patient_value": 110, "contribution_pct": 20}
        ], "gaps": {"not_provided": ["respiration_rate", "blood_pressure_systolic"], "assumed": ["oxygen_saturation"], "recorded_not_scored": [], "red_flag_input": [], "beyond_the_data": ["Appearance, work of breathing, distress, social context, staffing - outside this engine."]}}
      },
      "call": {"intake_id": 5004},
      "expect": {
        "status_code": 200,
        "system_ESI": "ESI-3",
        "band_name": "Urgent",
        "confidence": "LOW",
        "missing_fields": ["oxygen_saturation", "respiration_rate", "blood_pressure_systolic"],
        "gap_not_provided": ["respiration_rate", "blood_pressure_systolic"],
        "gap_assumed": ["oxygen_saturation"],
        "lede_present": true,
        "event_logged": "explanation_viewed"
      }
    },
    {
      "_name": "unknown_intake_id_404",
      "_why": "GET /intakes/{id} for a non-existent intake returns 404 not_found, no bundle.",
      "seed": {},
      "call": {"intake_id": 999999},
      "expect": {
        "status_code": 404,
        "error_code": "not_found",
        "no_bundle": true,
        "no_event_logged": true
      }
    },
    {
      "_name": "age_derived_from_dob",
      "_why": "Patient.age is derived from date_of_birth (not stored). Bundle must show the computed age, not a DOB field.",
      "seed": {
        "patient": {"patient_id": 104, "name": "Test Patient E", "date_of_birth": "1980-01-01", "sex": "F"},
        "intake_record": {"intake_id": 5005, "patient_id": 104, "chief_complaint": "cardiac", "missing_fields": []},
        "patient_severity": {"intake_id": 5005, "severity_score": 6, "system_ESI": "ESI-2", "clinician_ESI": null, "confidence": "HIGH", "red_flags": [], "red_flag_fired": false, "flag_tier": 3},
        "ai_explanation": {"intake_id": 5005, "data_completeness": "5 of 5", "factor_breakdown": [
          {"rule_id": 9, "factor": "Chief complaint", "threshold": "chest pain (cardiac concern)", "weight": 6, "patient_value": "cardiac", "contribution_pct": 100}
        ], "gaps": {"not_provided": [], "assumed": [], "recorded_not_scored": [], "red_flag_input": [], "beyond_the_data": ["Appearance, work of breathing, distress, social context, staffing - outside this engine."]}}
      },
      "call": {"intake_id": 5005},
      "expect": {
        "status_code": 200,
        "age_is_derived": true,
        "age_reference": "computed from 1980-01-01 at request time, not read from a stored age column",
        "lede_present": true
      }
    }
  ]
}