    {
      "_name": "post_override_expired_key_reexecutes",
      "_why": "Idempotency-Key exists but its created_at is older than IDEMPOTENCY_TTL (24h) -> check_idempotency treats it as absent -> applyOverride runs fresh; store_idempotency UPSERTS, resetting created_at.",
      "seed": {
        "patient_severity": {
          "severity_id": 8009,
          "intake_id": 7009,
          "system_ESI": "ESI-3",
          "clinician_ESI": null,
          "severity_score": 4,
          "flag_tier": 3
        },
        "intake_record": {
          "intake_id": 7009,
          "patient_id": 306
        },
        "queue_seed": [
          {
            "intake_id": 7009,
            "esi": "ESI-3",
            "flag_tier": 3
          }
        ],
        "idempotency_key_row": {
          "idempotency_key": "key-expired-009",
          "request_hash": "<any>",
          "response_body": {
            "stale": true
          },
          "status_code": 201,
          "created_at": "25 hours ago (past TTL)"
        }
      },
      "request": {
        "headers": {
          "Idempotency-Key": "key-expired-009"
        },
        "body": {
          "severity_id": 8009,
          "clinician_esi": "ESI-1",
          "reason_code": "AI driver incorrect",
          "note": null
