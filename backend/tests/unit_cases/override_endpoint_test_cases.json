        "applyOverride_called": true,
        "override_persisted": true,
        "idempotency_row_upserted": true,
        "created_at_reset": true
      },
      "_note": "Past-TTL key is NOT replayed - it re-executes and the upsert overwrites the stale row (created_at resets)."
    }
